{
  "description": "Load the doc-mastery workflow rules into every session",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/rules/workflow-rules.md\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
